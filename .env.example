# ============================================================
# GoldProof Environment Configuration Example
# Copy to .env for Docker or local development. Never commit .env.
# ============================================================

# Database: PostgreSQL (Docker) or SQLite (local fallback)
DATABASE_URL=sqlite:///./goldproof_dev.db
# PostgreSQL example (used by docker-compose):
# DATABASE_URL=postgresql+psycopg2://goldproof:goldproof_dev@db:5432/goldproof

# Authentication (change JWT_SECRET in any deployed environment)
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRE_MINUTES=720

# Ed25519 Signing Key (base64 encoded 32-byte raw private seed).
# If omitted in local dev, backend persists a dev key at backend/.keys/ed25519_dev.key
ED25519_PRIVATE_KEY_B64=

# Public App URL encoded into QR verification links
APP_PUBLIC_URL=http://localhost:3000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo Mode (seeds clearly labelled [DEMO] accounts & transactions on startup)
DEMO_MODE=true

# Configurable AI / LLM Provider (leave LLM_API_KEY empty to use local evidence explainer)
LLM_PROVIDER=local_evidence_explainer
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Configurable OCR Provider (auto | paddleocr | mock)
OCR_PROVIDER=auto

# Configurable Speech Provider (browser_web_speech | openai_whisper | sarvam)
SPEECH_PROVIDER=browser_web_speech
SPEECH_API_KEY=

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=GoldProof
